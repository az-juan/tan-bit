package views

templ Carrito(arts []ArticuloData, total float64, totalXmr float64) {
  @Route("CARRITO", "PIEZAS SELECCIONADAS")
  <nav class="checkout-steps">
    <span class="active">01 / CARRITO</span><span>02 / COMPRA</span>
  </nav>
  <div class="cart-layout">
    <section class="cart-items">
      for _, a := range arts {
        @Articulo(a, ArticuloConfig{
        Favorito: false,
        Carrito: false,
        Compra: false,
        Editar: false,
        Ficha: true,
        Quitar: "/carrito",
        })
      }
    </section>
    <aside class="summary-wrap">
      @Marco("veg-vl steel veg-3 copper cart-summary", ResumenCarrito(arts, total, totalXmr))
      <p class="direct"><span>Contacto directo con quien hizo tu pieza.</span></p>
    </aside>
  </div>
  @Bloque(
    "¿TODAVÍA ESTÁS EXPLORANDO?",
    "Tu próximo hallazgo puede estar a un clic. Las piezas guardadas te esperan en favoritos.",
    BotonEnlace("Volver al marketplace ↗", "/"),
  )
}

templ ResumenCarrito(arts []ArticuloData, total float64, totalXmr float64) {
  <h2 class="display">TU CARRITO [{ len(arts) }]</h2>
  <hr />
  <div><span>Envío</span><span>A coordinar</span></div>
  <hr />
  <small>TOTAL DE PRODUCTOS</small>
  <strong>${ total }</strong>
  <strong>{ totalXmr } XMR</strong>
  <p>
    El envío no está incluido. Vas a ver el detalle de cada vendedor antes de confirmar.
  </p>
  <a class="btn" href="/compra">Continuar con la compra &nbsp; ↗</a><small>Pesos argentinos · Otros medios de pago según el vendedor.</small>
}
