package views

import (
	db "tan-bit.com/tan-bit/db/sqlc"
)

templ Carrito(arts []db.GetCarritoByUsuarioRow, total float64, totalXmr float64) {
  <div class="route">
    <span>INICIO / CARRITO</span><span class="green">■ { len(arts) } PIEZAS SELECCIONADAS</span>
  </div>
  <nav class="checkout-steps">
    <span class="active">01 / CARRITO</span><span>02 / COMPRA</span>
  </nav>
  <div class="cart-layout">
    <section class="cart-items">
      for _, a := range arts {
        <div class="cart-item">
          <img class="item-detail" src={ a.RutaImagen.String } alt={ a.Titulo } />
          <span>{ a.Titulo }</span>
          <span>x{ a.Cantidad }</span>
          <span>${ a.Precio }</span>
        </div>
      }
    </section>
    <aside class="summary-wrap">
      <div class="pixel-frame veg-vl codo-2steel copper cart-summary">
        <h2 class="display">TU CARRITO [{ len(arts) }]</h2>
        <hr />
        <div><span>Envío</span><span>A coordinar</span></div>
        <hr />
        <small>TOTAL DE PRODUCTOS</small>
        <strong>${ total }</strong>
        <strong>{ totalXmr } XMR</strong>
        <p>
          El envío no está incluido. Vas a ver el detalle de cada vendedor antes de confirmar.
        </p>
        <a class="btn" href="/compra">Continuar con la compra &nbsp; ↗</a><small>Pesos argentinos · Otros medios de pago según el vendedor.</small>
      </div>
      <p class="direct"><span>Contacto directo con quien hizo tu pieza.</span></p>
    </aside>
  </div>
  <section class="return-cta">
    <div>
      <h2 class="display">¿TODAVÍA ESTÁS EXPLORANDO?</h2>
      <p>
        Tu próximo hallazgo puede estar a un clic. Las piezas guardadas te esperan en
        favoritos.
      </p>
    </div>
    <a class="btn" href="/">Volver al marketplace ↗</a>
  </section>
}
