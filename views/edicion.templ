package views

import (
	"strconv"

	"tan-bit.com/tan-bit/logic"
)

// VistaEditarArticulo es el modal con el formulario de edición.
templ VistaEditarArticulo(a ArticuloData) {
	<div class="modal-underlay" hx-on:click="document.getElementById('modal').innerHTML=''"></div>
	<div class="modal-content pixel-frame copper">
		<div class="modal-header">
			<h2 class="display">EDITAR PUBLICACIÓN</h2>
			<button type="button" class="modal-close" hx-on:click="document.getElementById('modal').innerHTML=''">Cerrar</button>
		</div>
		@Formulario("/articulos/"+strconv.Itoa(int(a.IDArticulo)), "post", "", "", false, FormEdicion(a))
	</div>
}

templ FormEdicion(a ArticuloData) {
	<div class="form-columns">
		<label><span>TÍTULO *</span><input class="field" name="titulo" value={ a.Titulo } required /></label>
		<label><span>UBICACIÓN *</span><input class="field" name="ubicacion" value={ a.Ubicacion } required /></label>
	</div>
	<div class="form-columns">
		<label><span>CATEGORÍA *</span><select class="field" name="categoria">
			for _, c := range logic.CategoriasDB() {
				<option value={ string(c) } selected?={ a.Categoria == string(c) }>{ CategoriaLabel(c) }</option>
			}
		</select></label>
		<label><span>CONDICIÓN *</span><select class="field" name="condicion">
			for _, c := range logic.CondicionesDB() {
				<option value={ string(c) } selected?={ a.Condicion == string(c) }>{ string(c) }</option>
			}
		</select></label>
	</div>
	<label><span>DESCRIPCIÓN *</span><textarea class="field" name="descripcion" rows="4" required>{ a.Descripcion }</textarea></label>
	<div class="form-columns">
		<label><span>PRECIO *</span><input class="field" name="precio" type="number" step="0.01" value={ a.Precio } required /></label>
		<label><span>PRECIO XMR</span><input class="field" name="precio_xmr" type="number" step="0.01" value={ a.PrecioXmr } /></label>
	</div>
	<div class="form-columns">
		<label><span>STOCK *</span><input class="field" name="stock" type="number" min="0" value={ a.Stock } required /></label>
		<label><span>TIPO DE ENTREGA *</span><select class="field" name="tipo_entrega"><option value="envio a domicilio" selected?={ a.TipoEntrega == "envio a domicilio" }>Envío a domicilio</option><option value="retiro en persona" selected?={ a.TipoEntrega == "retiro en persona" }>Retiro en persona</option><option value="ambos" selected?={ a.TipoEntrega == "ambos" }>Ambos</option></select></label>
	</div>
	<div class="form-columns">
		<label><span>COSTO DE ENVÍO</span><input class="field" name="costo_envio" type="number" step="0.01" placeholder="0.00" /></label>
		<label><span>ZONA DE ENTREGA</span><input class="field" name="zona_entrega" value={ a.ZonaEntrega.String } placeholder="Tandil y alrededores" /></label>
	</div>
	<button class="btn" type="submit">Guardar cambios ↗</button>
}
