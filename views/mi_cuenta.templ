package views

templ MiCuenta() {
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAN-BIT · Mi cuenta</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/mi_cuenta.css" />
  </head>
  <body>
    <div class="page account-page">
    @Header()
      <main class="container account-main">
        <div class="route"><span>INICIO / MI CUENTA</span><span class="green">■ PANEL PERSONAL</span></div>
        <h1 class="display page-title">MI CUENTA.</h1>
        <div class="account-grid">
          <aside class="account-sidebar">
            <div class="pixel-frame account-profile">
              <img src="/static/assets/account_user.svg" alt="Avatar" />
              <strong>Maker Tandil</strong>
              <small>maker@tanbit.com</small>
              <span class="green">■ USUARIO</span>
            </div>
            <nav class="account-nav">
              <a class="active">Datos personales</a>
              <a>Mis piezas</a>
              <a>Favoritos</a>
              <a>Pedidos</a>
              <a>Seguridad</a>
            </nav>
          </aside>
          <section class="account-content">
            <div class="pixel-frame account-card">
              <h2 class="display">DATOS PERSONALES</h2>
              <div class="account-form">
                <label class="form-group"><span class="field-label">NOMBRE</span><input class="field" value="Maker" /></label>
                <label class="form-group"><span class="field-label">APELLIDO</span><input class="field" value="Tandil" /></label>
                <label class="form-group"><span class="field-label">EMAIL</span><input class="field" type="email" value="maker@tanbit.com" /></label>
                <label class="form-group"><span class="field-label">TELÉFONO</span><input class="field" placeholder="+54 ..." /></label>
                <button class="btn">Guardar cambios ↗</button>
              </div>
            </div>
            <div class="account-stats">
              <div class="pixel-frame stat"><span>PIEZAS PUBLICADAS</span><strong class="display">04</strong></div>
              <div class="pixel-frame stat"><span>FAVORITOS</span><strong class="display">12</strong></div>
              <div class="pixel-frame stat"><span>PEDIDOS</span><strong class="display">03</strong></div>
            </div>
            <div class="pixel-frame account-card">
              <h2 class="display">SEGURIDAD</h2>
              <div class="account-form">
                <label class="form-group"><span class="field-label">CONTRASEÑA ACTUAL</span><input class="field" type="password" /></label>
                <label class="form-group"><span class="field-label">NUEVA CONTRASEÑA</span><input class="field" type="password" /></label>
                <button class="btn ghost">Cambiar contraseña ↗</button>
              </div>
            </div>
          </section>
        </div>
      </main>
      @Footer()
    </div>
  </body>
</html>
}