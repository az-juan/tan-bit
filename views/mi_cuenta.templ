package views

import (
	"fmt"

	"tan-bit.com/tan-bit/db/sqlc"
)

templ MiCuenta(usuario UsuarioData, articulos []ArticuloData, favoritos []ArticuloData, compras []db.GetComprasByUsuarioRow) {
    @Route("MI CUENTA", "PANEL PERSONAL")
    <h1 class="display page-title">MI CUENTA.</h1>
    <div class="account-grid">
        <aside class="account-sidebar">
            @Marco("veg-tl verdigris veg-2 account-profile", Perfil(usuario))
            @Navegacion()
        </aside>
        <section class="account-content">
            @Marco("veg-h codo-2 verdigris veg-3 account-card", Formulario("/mi_cuenta", "post", "", "", false, DatosPersonales(usuario)))
            @Marco("veg-vs codo-2 codo-3 steel-dark account-card", MisPiezas(articulos))
            @Marco("veg-b codo-2 codo-3 steel-dark account-card", FavoritosUsuario(favoritos))
            @Marco("veg-b codo-2 codo-3 steel-dark account-card", Pedidos(compras))
            @Marco("veg-vs codo-2 codo-3 steel-dark account-card", Formulario("/mi_cuenta", "post", "", "", false, Seguridad()))
        </section>
    </div>
}

templ Perfil(usuario UsuarioData) {
	<img src={"/static/assets/" + map[bool]string{true: "account_seller.svg", false: "account_user.svg"}[usuario.Telefono != 0]} alt="Avatar" />
	<strong>{ usuario.Nombre } { usuario.Apellido }</strong>
	<small>{ usuario.Email }</small>
	<span class="green">{ "■ " + map[bool]string{true: "VENDEDOR", false: "USUARIO"}[usuario.Telefono != 0] }</span>
}

templ DatosPersonales(usuario UsuarioData) {
	<h2 class="display">DATOS PERSONALES</h2>
	<div class="account-form">
		@Campo("NOMBRE", "nombre", "text", "", usuario.Nombre, false)
		@Campo("APELLIDO", "apellido", "text", "", usuario.Apellido, false)
		@Campo("EMAIL", "email", "email", "", usuario.Email, false)
		@Campo("TELÉFONO", "telefono", "text", "+54 ...", fmt.Sprintf("%d", usuario.Telefono), false)
		if usuario.Telefono != 0 {
			<div class="account-card vendedor-data">
				<h2 class="display">DATOS DE VENDEDOR</h2>
				<div class="account-form">
					@Campo("ALIAS", "alias", "text", "", usuario.Alias, false)
					@Campo("CBU", "cbu", "text", "", usuario.Cbu, false)
					@Campo("DIRECCIÓN XMR", "direccion_xmr", "text", "-", usuario.DireccionXmr.String, false)
				</div>
			</div>
		}
		<button class="btn" type="submit">Guardar cambios ↗</button>
	</div>
}

templ MisPiezas(articulos []ArticuloData) {
	<h2 class="display" id="mis_piezas">MIS PIEZAS</h2>
	<div class="account-form">
		if len(articulos) > 0 {
			<p class="green">Hay piezas publicadas.</p>
			for _, a := range articulos {
				@Articulo(a, ArticuloConfig{
					Editar: true,
					Borrar: true,
				})
			}
		} else {
			<p class="green">Aún no publicas piezas.</p>
		}
	</div>
}

templ FavoritosUsuario(articulos []ArticuloData) {
	<h2 class="display" id="favoritos">FAVORITOS</h2>
	<div class="account-form">
		if len(articulos) > 0 {
			for _, f := range articulos {
				@Articulo(f, ArticuloConfig{})
			}
		} else {
			<p class="green">No tienes favoritos.</p>
		}
	</div>
}

templ Pedidos(compras []db.GetComprasByUsuarioRow) {
	<h2 class="display" id="pedidos">PEDIDOS</h2>
	<div class="account-form">
		if len(compras) > 0 {
			for _, c := range compras {
				@Marco("veg-tl codo-2 codo-3 brass veg-2 mini-card", PedidoItem(c))
			}
		} else {
			<p class="green">No realizaste pedidos.</p>
		}
	</div>
}

templ PedidoItem(c db.GetComprasByUsuarioRow) {
	<strong>Compra #{c.IDCompra}</strong>
	<small>{ c.Fecha.String() } · Total: { c.Total }</small>
}

templ Seguridad() {
	<h2 class="display" id="seguridad">SEGURIDAD</h2>
	<div class="account-form">
		@Campo("CONTRASEÑA ACTUAL", "password_actual", "password", "", "", true)
		@Campo("NUEVA CONTRASEÑA", "password_nueva", "password", "", "", true)
		<button class="btn ghost">Cambiar contraseña ↗</button>
	</div>
}

templ Navegacion() {
    <nav class="account-nav">
        <a class="active">Datos personales</a>
        <a href="#mis_piezas">Mis piezas</a>
        <a href="#favoritos">Favoritos</a>
        <a href="#pedidos">Pedidos</a>
        <a href="#seguridad">Seguridad</a>
        <form method="POST" action="/logout" style="display:inline">
            <button type="submit" class="btn" style="background:var(--rojo-1);color:white;border:none;padding:4px 12px;cursor:pointer;text-decoration:none">Cerrar sesión</button>
        </form>
        <form method="POST" action="/mi_cuenta/delete" style="display:inline" onsubmit="return confirm('¿Seguro que querés borrar tu cuenta? Esta acción no se puede deshacer.');">
            <button type="submit" class="btn" style="background:var(--rojo-0);color:white;border:none;padding:4px 12px;cursor:pointer;text-decoration:none">Borrar cuenta</button>
        </form>
    </nav>
}
