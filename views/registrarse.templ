package views

templ Registrarse() {
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAN-BIT · Registrarse</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/registrarse.css" />
  </head>
  <body>
    <div class="page register-page">
    @Header()
      <main class="register-main">
        <div class="route">
          <span>INICIO / REGISTRARSE</span><span class="green">■ NUEVA CUENTA</span>
        </div>
        <div class="register-grid">
          <section class="register-intro">
            <p class="eyebrow">HARDWARE CON IDENTIDAD.</p>
            <h1 class="display">CREÁ TU<br />CUENTA.</h1>
            <p>Sumate a la comunidad de makers y empezá a circular hardware con identidad.</p>
            <img src="/static/assets/bmo.png" alt="Ilustracion de aparatos tecnologicos" />
          </section>
          <section class="register-form-wrap">
            <form class="pixel-frame register-form" method="post" action="/registrarse">
              <p class="eyebrow">[ NUEVA CUENTA ]</p>
              <h2 class="display">BIENVENIDO.</h2>
              <p>Completá tus datos para empezar.</p>
              <label class="form-group"
                ><span class="field-label">NOMBRE</span><input class="field" name="nombre" placeholder="Tu nombre" /></label>
              <label class="form-group"
                ><span class="field-label">APELLIDO</span><input class="field" name="apellido" placeholder="Tu apellido" /></label>
              <label class="form-group"
                ><span class="field-label">EMAIL</span><input class="field" type="email" name="email" placeholder="tu.señal@correo.com" /></label>
              <label class="form-group"
                ><span class="field-label">TELÉFONO (OPCIONAL)</span><input class="field" name="telefono" placeholder="+54 ..." /></label>
              <label class="form-group"
                ><span class="field-label">CONTRASEÑA</span><input class="field" type="password" name="password" placeholder="••••••••" /></label>
              <label class="form-group"
                ><span class="field-label">REPETIR CONTRASEÑA</span><input class="field" type="password" name="password2" placeholder="••••••••" /></label>
              <label class="check"><input type="checkbox" /> Acepto los términos del servicio y la política de privacidad.</label>
              <button class="btn" type="submit">Crear cuenta &nbsp; ↗</button>
              <hr />
              <p>¿Ya tenés cuenta?</p>
              <a class="btn ghost" href="./login">Iniciar sesión &nbsp; ↗</a>
            </form>
            <p class="form-legal">
              Al registrarte, accedés a un espacio de intercambio respetuoso. Consultá los términos y
              la política de privacidad.
            </p>
          </section>
        </div>
      </main>
      @Footer()
    </div>
  </body>
</html>
}
