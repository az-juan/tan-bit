package views

templ Evento() {
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAN-BIT · Hardware Club</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/evento.css" />
  </head>
  <body>
    @Header()
    <div class="page event-page">
     <main class="container event-main">
        <section class="event-intro">
          <div class="route">
            <span>INICIO / COMUNIDAD / EVENTO</span><span class="green">■ EDICIÓN DEMO</span>
          </div>
          <h1 class="display page-title">DEL TALLER A LA MESA.</h1>
        </section>
        <section class="pixel-frame copper event-hero">
          <div class="event-copy">
            <span class="green">■ ENCUENTRO MAKER / TANDIL</span>
            <h2 class="display">TAN-BIT<br />HARDWARE CLUB</h2>
            <p>
              Teclados abiertos, circuitos a la vista y materiales que no esperabas encontrar en un
              escritorio.
            </p>
            <div class="date-grid">
              <div><strong class="display">SÁB 21 NOV</strong><small>14:00 — 20:00 H</small></div>
              <div><strong class="display">TANDIL</strong><small>ESPACIO A CONFIRMAR</small></div>
            </div>
            <a class="btn" href="#reserva">Quiero participar ↗</a><small>Programación y fecha ilustrativas para esta plantilla.</small>
          </div>
          <figure>
            <img src="/static/assets/4ff96.png" alt="Encuentro de creadores trabajando con hardware" />
            <figcaption>HARDWARE REAL. CONVERSACIONES SIN FILTRO.</figcaption>
          </figure>
        </section>
        <div class="event-content">
          <section class="schedule">
            <h2 class="display">CONECTÁ CON LA ESCENA.</h2>
            <p>Una tarde para compartir lo que sabés y descubrir lo que todavía no probaste.</p>
            <ol>
              <li>
                <time>14:00</time>
                <div>
                  <strong>Abrimos el taller</strong><span>Mesa de piezas, bienvenida y café.</span>
                </div>
              </li>
              <li>
                <time>15:00</time>
                <div>
                  <strong>Anatomía de un teclado</strong><span>Switches, placas y una buena sesión de prueba.</span>
                </div>
              </li>
              <li>
                <time>16:30</time>
                <div>
                  <strong>Materiales fuera de serie</strong><span>Madera, cobre y piedra dentro del hardware.</span>
                </div>
              </li>
              <li>
                <time>18:00</time>
                <div>
                  <strong>Reparar antes que descartar</strong><span>Diagnóstico colectivo y circulación de componentes.</span>
                </div>
              </li>
              <li>
                <time>19:00</time>
                <div>
                  <strong>Intercambio de señales</strong><span>Mostrá tu proyecto y conocé a otros creadores.</span>
                </div>
              </li>
            </ol>
          </section>
          <section id="reserva" class="reservation">
            <form class="pixel-frame">
              <p class="eyebrow">RESERVÁ TU LUGAR</p>
              <h2 class="display">SUMATE A LA MESA.</h2>
              <p>
                Dejanos tu señal para recibir la confirmación del lugar y los detalles del
                encuentro.
              </p>
              <label
                ><span>NOMBRE</span><input class="field" placeholder="¿Cómo te llamás?" /></label><label
                ><span>EMAIL</span><input class="field" placeholder="tu.señal@correo.com" /></label><label class="check"
                ><input type="checkbox" /><span
                  >Quiero recibir información de este evento y leí la política de privacidad.</span></label><button class="btn">Anotarme al encuentro ↗</button><small>ENTRADA LIBRE · CUPO LIMITADO</small>
            </form>
            <p>¿Querés llevar una pieza o dar una charla? Escribinos desde Contactanos.</p>
          </section>
        </div>
      </main>
        @Footer()
    </div>
  </body>
</html>
}
