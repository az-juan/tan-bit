package views

templ Creadores() {
	<section>
		@Route("CREADORES", "DIRECTORIO DE TALLERES")
		<h1 class="display page-title">CONOCÉ LOS CREADORES.</h1>
	</section>
	@Hero(
		"EL GABINETE SALE DEL TALLER.",
		CreadoresCopy(),
		CreadoresArte(),
	)
	<section>
		<div class="section-head">
			<h2 class="display">EXPLORÁ LOS TALLERES [3]</h2>
			<nav class="filter-nav"><a class="active">TODOS</a><a>ELECTRÓNICA</a><a>CARPINTERÍA</a><a>OBJETOS</a></nav>
		</div>
		<div class="cards-grid">
			@CreadorCard("TC", "Taller Cobre", "TANDIL, ARGENTINA", "TECLADOS Y ELECTRÓNICA", "Switches elegidos a mano, madera trabajada con paciencia y una obsesión por el sonido justo.", "06 PIEZAS", "/static/assets/teclado.png")
			@CreadorCard("NN", "Nodo Nogal", "TANDIL, ARGENTINA", "GABINETES DE AUTOR", "Diseño térmico y carpintería en la misma mesa. Gabinetes que no se esconden debajo del escritorio.", "04 PIEZAS", "/static/assets/gabinete.png")
			@CreadorCard("SC", "Sur Cuero", "TANDIL, ARGENTINA", "OBJETOS DE ESCRITORIO", "Cuero curtido vegetal, costuras honestas y objetos que ganan carácter con cada día de uso.", "08 PIEZAS", "/static/assets/pad.png")
		</div>
	</section>
	@Bloque(
		"¿TU TALLER TODAVÍA NO ESTÁ ACÁ?",
		"Mostrá lo que hacés, contá tu proceso y encontrá a quienes valoran una pieza bien hecha.",
		BotonEnlace("Sumarme como creador ↗", "./vender"),
	)
}

templ CreadoresCopy() {
	<span class="green">■ EN FOCO / NODO NOGAL</span>
	<p>Una veta nunca se repite. Un buen diseño tampoco tiene por qué parecerse a todos los demás.</p>
	<small>Conocé el proceso detrás del Nogal T-01: de la selección de la madera al último ajuste del panel.</small>
	@BotonEnlace("Conocer el proceso ↗", "#")
}

templ CreadoresArte() {
	<img src="/static/assets/gabinete.png" alt="Gabinete de nogal" />
}

templ CreadorCard(logo string, nombre string, ubicacion string, categoria string, descripcion string, piezas string, imagen string) {
	<article class="carta carta-media">
		<img src={ imagen } alt={ nombre } />
		<div>
			<div class="card-head"><span class="card-logo">{ logo }</span><div><strong>{ nombre }</strong><small>{ ubicacion }</small></div></div>
			<span class="card-cat">{ categoria }</span>
			<p>{ descripcion }</p>
			<div class="card-foot"><span>{ piezas }</span><a class="btn" href="#">Ver taller ↗</a></div>
		</div>
	</article>
}
