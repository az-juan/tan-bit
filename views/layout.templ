package views

import (
	"tan-bit.com/tan-bit/logic"
	"net/http"
)
templ Header(userRole string) {
    <header class="site-header">
      <a class="brand" href="./">
        <img src="/static/assets/tanbit_logo.svg" alt="TAN-BIT logo" />
      </a>
      <div class="site-search">
        <img src="/static/assets/search.svg" alt="" />
        <form class="search-form" hx-get="/search" hx-target="#search-results" hx-trigger="input changed delay:300ms" hx-push-url="true" hx-params="no-body">
          <input
            type="text"
            name="q"
            placeholder="Buscar artículos..."
            class="search-input"
            autocomplete="off"
          />
        </form>
      </div>
      <nav class="header-actions">
        <a href="./vender">VENDER</a>
        <a href="./favoritos">
          <img src="/static/assets/heart.svg" alt="Favoritos" />
        </a>
        <a class="cart-link" href="./carrito">
          <img src="/static/assets/carrito.svg" alt="" />
        </a>
        <div class="account-dropdown-wrap">
          <a href="./mi_cuenta" class="account-btn">
            <img class="account" src="/static/assets/account.svg" alt="Cuenta" />
          </a>
        </div>
      </nav>
    </header>
}

templ SearchForm() {
    <div class="search-inline-results-wrap">
      <div class="search-inline-results" id="search-results"></div>
    </div>
}

templ Footer() {
      <footer class="site-footer">
        <div class="values">
          <div class="value">
            <img src="/static/assets/descentralizado.svg" alt="" />
            <div>
              <strong>DESCENTRALIZADO.</strong><span>Sin intermediarios entre clientes y vendedores.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/confianza.svg" alt="" />
            <div>
              <strong>CONFIANZA.</strong><span>Comunidad de Tandil, confianza de Tandil.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/oportunidad.svg" alt="" />
            <div>
              <strong>OPORTUNIDAD.</strong><span>Darle otra vida a aquello que dabas por descartado.</span>
            </div>
          </div>
        </div>
        <div class="footer-main">
          <div class="footer-column">
            <div class="footer-brand">
              <img src="/static/assets/tanbit_logo.svg" alt="TAN-BIT logo" />
            </div>
            <p>Con el fin de facilitar la circulación del hardware.</p>
          </div>
          <div class="footer-column">
            <h3>AYUDA</h3>
            <a href="./contacto">Contactanos</a><a href="./vender">Quiero vender</a>
          </div>
          <div class="footer-column">
            <h3>CONOCE TAN-BIT</h3>
            <a href="./historia">Historia</a><a href="./creadores">Creadores</a>
          </div>
          <div class="footer-column">
            <h3 class="aviso-title">AVISOS</h3>
            <p>Hallazgos, historias y un poco de ruido de señal.</p>
            <div class="newsletter">tu.señal@correo.com <span>→</span></div>
          </div>
        </div>
        <div class="legal">
          <span>© 2026 TAN-BIT. Todos los derechos reservados.</span><a href="./privacidad">Política de privacidad &nbsp;</a><a href="./terminos">Términos del servicio &nbsp;</a><span>Argentina · Pesos $ · Crypto</span>
        </div>
      </footer>
}

templ Head() {
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TAN-BIT · Marketplace</title>
  <link rel="stylesheet" href="/static/css/layout.css" />
  <link rel="stylesheet" href="/static/css/articulo.css" />
  <link rel="stylesheet" href="/static/css/shared.css" />
  <link rel="stylesheet" href="/static/css/colors.css" />
  <link rel="stylesheet" href="/static/css/fonts.css" />
  <link rel="stylesheet" href="/static/css/modal.css" />
  <link rel="stylesheet" href="/static/css/compra.css" />
  <link rel="stylesheet" href="/static/css/carrito.css" />
  <link rel="stylesheet" href="/static/css/favoritos.css" />
  <link rel="stylesheet" href="/static/css/mi_cuenta.css" />
  <link rel="stylesheet" href="/static/css/contacto.css" />
  <link rel="stylesheet" href="/static/css/terminos.css" />
  <link rel="stylesheet" href="/static/css/privacidad.css" />
  <link rel="stylesheet" href="/static/css/marketplace.css" />
  <link rel="stylesheet" href="/static/css/login.css" />
  <link rel="stylesheet" href="/static/css/registrarse.css" />
  <link rel="stylesheet" href="/static/css/vender.css" />
  <script src="/static/htmx.min.js"></script>
  <script>htmx.config.historyRestoreAsHxRequest = false</script>
</head>
}

templ Base(contenido templ.Component, session string) {
  <!doctype html>
  <html lang="es">
    <body hx-boost="true" hx-target="#main">
      @Head()
      @Header("")
      <main class="container" id="main">
        @contenido
      </main>
      @Footer()
      <div id="modal"></div>
      @Notificaciones(logic.TakeNotifications(session))
    </body>
  </html>
}

templ Pagina(w http.ResponseWriter, r *http.Request, contenido templ.Component) {
    if logic.IsHtmxRequest(r) {
        @Notificaciones(logic.TakeNotifications(logic.SessionID(w, r)))
        @contenido   // solo el fragmento + notificaciones OOB
    } else {
        @Base(contenido, logic.SessionID(w, r))
    }
}
