package views

templ Footer() {
      <footer class="site-footer">
        <div class="values">
          <div class="value">
            <img src="/static/assets/descentralizado.svg" alt="" />
            <div>
              <strong>DESCENTRALIZADO.</strong><span>Sin intermediarios entre clientes y vendedores.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/confianza.svg" alt="" />
            <div>
              <strong>CONFIANZA.</strong><span>Comunidad de Tandil, confianza de Tandil.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/oportunidad.svg" alt="" />
            <div>
              <strong>OPORTUNIDAD.</strong><span>Darle otra vida a aquello que dabas por descartado.</span>
            </div>
          </div>
        </div>
        <div class="footer-main">
          <div class="footer-column">
            <div class="footer-brand">
              <img src="/static/assets/logo.png" alt="" />
              <h3>TAN-BIT</h3>
            </div>
            <p>Con el fin de facilitar la circulación del hardware.</p>
          </div>
          <div class="footer-column">
            <h3>AYUDA</h3>
            <a>Contactanos</a><a href="./vender">Quiero vender</a>
          </div>
          <div class="footer-column">
            <h3>MEET TAN-BIT</h3>
            <a>Our story</a><a>Our makers</a>
          </div>
          <div class="footer-column">
            <h3>INCOMING TRANSMISSION</h3>
            <p>Hallazgos, historias maker y un poco de ruido de señal.</p>
            <div class="newsletter">tu.señal@correo.com <span>→</span></div>
          </div>
        </div>
        <div class="legal">
          <span>© 2026 TAN-BIT. Todos los derechos reservados.</span><span>Política de privacidad &nbsp; Términos del servicio &nbsp; Argentina · Pesos $ ·
            Crypto</span>
        </div>
      </footer>
}

templ Header() {
    <header class="site-header">
      <a class="brand" href="./"><img src="/static/assets/logo.png" alt="TAN-BIT" /><span>TAN-BIT</span></a>
      <div class="site-search">
        <img src="/static/assets/search.svg" alt="" /><span>Buscar tu próxima joya del hardware</span>
      </div>
      <nav class="header-actions">
        <a href="./vender">VENDER</a>
        <a href="./favoritos">
          <img src="/static/assets/heart.svg" alt="Favoritos" />
        </a>
        <a class="cart-link" href="./carrito">
          <img src="/static/assets/cart.svg" alt="" />CARRITO [0]
        </a>
        <a href="./login">
          <img class="account" src="/static/assets/account.svg" alt="Cuenta" />
        </a>
      </nav>
    </header>
 }
