package views

templ Header() {
    <header class="site-header">
      <a class="brand" href="./">
        <img src="/static/assets/tanbit_logo.svg" alt="TAN-BIT logo" />
        // <span>TAN-BIT</span>
      </a>
      <div class="site-search">
        <img src="/static/assets/search.svg" alt="" />
        <span>Buscar tu próxima joya del hardware</span>
      </div>
      <nav class="header-actions">
        <a href="./vender">VENDER</a>
        <a href="./favoritos">
          <img src="/static/assets/heart.svg" alt="Favoritos" />
        </a>
        <a class="cart-link" href="./carrito">
          <img src="/static/assets/cart.svg" alt="" />CARRITO [0]
        </a>
        <a href="./login">
          <img class="account" src="/static/assets/account.svg" alt="Cuenta" />
        </a>
      </nav>
    </header>
 }

templ Footer() {
      <footer class="site-footer">
        <div class="values">
          <div class="value">
            <img src="/static/assets/descentralizado.svg" alt="" />
            <div>
              <strong>DESCENTRALIZADO.</strong><span>Sin intermediarios entre clientes y vendedores.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/confianza.svg" alt="" />
            <div>
              <strong>CONFIANZA.</strong><span>Comunidad de Tandil, confianza de Tandil.</span>
            </div>
          </div>
          <div class="value">
            <img src="/static/assets/oportunidad.svg" alt="" />
            <div>
              <strong>OPORTUNIDAD.</strong><span>Darle otra vida a aquello que dabas por descartado.</span>
            </div>
          </div>
        </div>
        <div class="footer-main">
          <div class="footer-column">
            <div class="footer-brand">
              <img src="/static/assets/tanbit_logo.svg" alt="TAN-BIT logo" />
              // <h3>TAN-BIT</h3>
            </div>
            <p>Con el fin de facilitar la circulación del hardware.</p>
          </div>
          <div class="footer-column">
            <h3>AYUDA</h3>
            <a href="./contacto">Contactanos</a><a href="./vender">Quiero vender</a>
          </div>
          <div class="footer-column">
            <h3>CONOCE TAN-BIT</h3>
            <a href="./historia">Historia</a><a href="./creadores">Creadores</a>
          </div>
          <div class="footer-column">
            <h3>AVISOS</h3>
            <p>Hallazgos, historias y un poco de ruido de señal.</p>
            <div class="newsletter">tu.señal@correo.com <span>→</span></div>
          </div>
        </div>
        <div class="legal">
          <span>© 2026 TAN-BIT. Todos los derechos reservados.</span><a href="./privacidad">Política de privacidad &nbsp;</a><a href="./terminos">Términos del servicio &nbsp;</a><span>Argentina · Pesos $ · Crypto</span>
        </div>
      </footer>
}
