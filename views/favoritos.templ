package views

import "tan-bit.com/tan-bit/db/sqlc"

templ Favoritos(arts []db.GetFavoritosByUsuarioRow, filtros []FiltroCategoria) {

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAN-BIT · Favoritos</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/favoritos.css" />
  </head>
  <body>
    <div class="page favorites-page">
    @Header()
     <main class="container favorites-main">
        <section>
          <div class="route">
            <span>INICIO / FAVORITOS</span><span class="green">■ COLECCIÓN PERSONAL</span>
          </div>
          <h1 class="display page-title">TUS JOYAS, A MANO.</h1>
        </section>
        <div class="favorite-controls">
          <div class="filters">
          for i, f := range filtros {
            if i == 0 {
              <button class="active">{ f.Label } [{ f.Count }]</button>
            } else {
              <button>{ f.Label } [{ f.Count }]</button>
            }
          }
        </div>
          <span>ORDENAR: GUARDADOS RECIENTEMENTE ↓</span>
        </div>
        <section class="pixel-frame veg-bl codo-2oxide veg-2 favorites-articulos">
          <div class="articulo-grid">
            for _, a := range arts {
              <article class="product-card">
                <div class="product-image">
                  <img src={ a.RutaImagen.String } alt={ a.Titulo } />
                </div>
                <div class="product-info">
                  <h2 class="product-name">{ a.Titulo }</h2>
                  if a.PrecioXmr > 0 {
                    <p class="product-price">${ a.Precio } · { a.PrecioXmr } XMR</p>
                  } else {
                    <p class="product-price">${ a.Precio }</p>
                  }
                </div>
              </article>
            }
          </div>
        </section>
        <div class="saved-note">
          <span>♥ &nbsp;{ len(arts) } piezas guardadas. Los favoritos no reservan stock.</span><a href="/">Seguir explorando ↗</a>
        </div>
        <section class="maker-cta">
          <div>
            <h2 class="display">DETRÁS DE CADA PIEZA, UN CREADOR.</h2>
            <p>
              Conocé los talleres y las personas que hacen distinto el hardware de todos los días.
            </p>
          </div>
          <a class="btn" href="./creadores">Conocer creadores ↗</a>
        </section>
      </main>
      @Footer()
    </div>
  </body>
</html>}
