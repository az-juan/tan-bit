package views

import (
)

templ Favoritos(arts []ArticuloData, filtros []FiltroCategoria) {
        <section>
          @Route("FAVORITOS", "COLECCIÓN PERSONAL")
          <h1 class="display page-title">TUS JOYAS, A MANO.</h1>
        </section>
        <div class="favorite-controls">
          <div class="filters" role="tablist">
            for _, f := range filtros {
                <a role="tab" href={ "/favoritos?categoria=" + string(f.Key) } hx-get={"/favoritos?categoria=" + string(f.Key) } hx-target="#favoritos-content" hx-swap="outerHTML" hx-push-url="true">
                  { f.Label } [{ f.Count }]
                </a>
            }
          </div>
            <span>ORDENAR: GUARDADOS RECIENTEMENTE ↓</span>
        </div>
        @GrillaFavoritos(arts)
        <div class="saved-note">
          <span>♥ &nbsp;{ len(arts) } piezas guardadas. Los favoritos no reservan stock.</span><a href="/">Seguir explorando ↗</a>
        </div>
        @Bloque(
          "DETRÁS DE CADA PIEZA, UN CREADOR.",
          "Conocé los talleres y las personas que hacen distinto el hardware de todos los días.",
          BotonEnlace("Conocer creadores ↗", "./creadores"),
        )
}

// GrillaFavoritos es el fragmento que recargan los filtros de la página (htmx).
templ GrillaFavoritos(articulos []ArticuloData) {
        <section class="pixel-frame veg-bl codo-2 oxide veg-2" id="favoritos-content">
          <div class="product-grid">
            for _, a := range articulos {
              @Articulo(a, ArticuloConfig{
                Favorito: false,
                Carrito: true,
                Compra: false,
                Editar: false,
                Ficha: true,
                Quitar: "/favoritos",
              })
            }
          </div>
        </section>
}
