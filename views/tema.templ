package views

script toggleTheme() {
	const html = document.documentElement;
	const next = html.getAttribute("data-theme") === "claro" ? "oscuro" : "claro";
	html.setAttribute("data-theme", next);
	document.cookie = "theme=" + next + "; path=/; max-age=31536000; SameSite=Lax";
}

templ ThemeToggle() {
	<button type="button" class="theme-toggle-btn" onclick={ toggleTheme() } aria-label="Cambiar tema">
		<span class="only-oscuro">
			<svg width="24" height="24" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
				<!-- Núcleo sol -->
				<rect x="4" y="4" width="4" height="4"></rect>
				<!-- Rayos sol (3px) -->
				<rect x="5" y="0" width="2" height="3"></rect>
				<rect x="5" y="9" width="2" height="3"></rect>
				<rect x="0" y="5" width="3" height="2"></rect>
				<rect x="9" y="5" width="3" height="2"></rect>
				<!-- Rayos diagonales largos (3px) -->
				<rect x="0" y="0" width="1" height="1"></rect>
				<rect x="1" y="1" width="1" height="1"></rect>
				<rect x="2" y="2" width="1" height="1"></rect>
				<rect x="11" y="0" width="1" height="1"></rect>
				<rect x="10" y="1" width="1" height="1"></rect>
				<rect x="9" y="2" width="1" height="1"></rect>
				<rect x="0" y="11" width="1" height="1"></rect>
				<rect x="1" y="10" width="1" height="1"></rect>
				<rect x="2" y="9" width="1" height="1"></rect>
				<rect x="11" y="11" width="1" height="1"></rect>
				<rect x="10" y="10" width="1" height="1"></rect>
				<rect x="9" y="9" width="1" height="1"></rect>
			</svg>
		</span>
		<span class="only-claro">
			<svg width="24" height="24" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
				<!-- Luna  -->
				<rect x="4" y="1" width="3" height="1"></rect>
				<rect x="2" y="2" width="4" height="1"></rect>
				<rect x="2" y="3" width="3" height="1"></rect>
				<rect x="1" y="4" width="3" height="3"></rect>
				<rect x="1" y="7" width="4" height="1"></rect>
				<rect x="10" y="7" width="1" height="1"></rect>
				<rect x="2" y="8" width="5" height="1"></rect>
				<rect x="9" y="8" width="2" height="1"></rect>
				<rect x="2" y="9" width="8" height="1"></rect>
				<rect x="4" y="10" width="4" height="1"></rect>
				<!-- Estrellas -->
				<rect x="8" y="2" width="1" height="1"></rect>
				<rect x="9" y="4" width="1" height="1"></rect>
			</svg>
		</span>
	</button>
}