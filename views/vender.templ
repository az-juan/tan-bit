package views

templ Vender() {

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAN-BIT · Vender</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/vender.css" />
  </head>
  <body>
    <div class="page sell-page">
    @Header()
      <main class="container sell-main">
        <section class="sell-intro">
          <div class="route"><span>INICIO / VENDER</span></div>
          <h1 class="display page-title">DALE CIRCULACIÓN A TU HARDWARE.</h1>
        </section>
        <nav class="sell-steps">
          <span class="active">01 / TU PIEZA</span><span>02 / PRECIO Y ENTREGA</span>
          <span>03 / REVISAR Y PUBLICAR</span>
        </nav>
        <div class="sell-layout">
          <form class="pixel-frame sell-form">
            <div class="form-title">
              <h2 class="display">01. CONTANOS SOBRE TU PIEZA</h2>
              <span>* OBLIGATORIO</span>
            </div>
            <label>
              <span>TÍTULO DE LA PUBLICACIÓN *</span>
              <input class="field" placeholder="Ej. Teclado mecánico de nogal · 75%"/>
            </label>
            <div class="form-columns">
              <label>
                <span>CATEGORÍA *</span>
                  <select class="field">
                  <option>Electrónica</option>
                </select></label>
                <label><span>ESTADO *</span><select class="field">
                  <option>Hecho a mano · nuevo</option>
                </select></label>
            </div>
            <label><span>DESCRIPCIÓN *</span><textarea
                class="field"
                rows="4"
                placeholder="Contá qué la hace especial: materiales, proceso, compatibilidad y todo lo que incluye."
              ></textarea>
            </label>
            <small
              >Hecho por vos, contado por vos. Sé preciso con el estado y las especificaciones. Una
              buena ficha evita sorpresas.</small>
            <h3 class="display">FOTOS DE TU HARDWARE</h3>
            <div class="upload">
              <strong>+</strong>
              <div>
                <b>Arrastrá tus fotos o elegí archivos</b><small>JPG o PNG · hasta 10 MB · de 3 a 8 imágenes</small><a>SELECCIONAR FOTOS ↗</a>
              </div>
            </div>
            <div class="form-columns">
              <label><span>MATERIALES</span><input class="field" placeholder="Nogal, aluminio, cobre…" /></label><label
                ><span>UBICACIÓN *</span><input class="field" value="Tandil, Buenos Aires"
              /></label>
            </div>
            <div class="form-submit">
              <span>Tu publicación todavía no es visible.</span><button class="btn">Continuar ↗</button>
            </div>
          </form>
          <aside class="sell-aside">
            <div class="pixel-frame preview"><small>VISTA PREVIA / BORRADOR</small><img src="/static/assets/e0654.png" alt="Vista previa de teclado" />
              <h2 class="display">TU PRÓXIMA PUBLICACIÓN</h2>
              <p>
                Las fotos y los detalles de tu pieza aparecerán acá mientras completás la ficha.
              </p>
              <span class="green">■ GUARDADO COMO BORRADOR</span>
            </div>
            <div class="tips">
              <h2 class="display">UNA BUENA FICHA, MÁS CONFIANZA.</h2>
              <p>01 &nbsp; Luz natural y fondo simple.</p>
              <p>02 &nbsp; Mostrá conexiones y detalles.</p>
              <p>03 &nbsp; Aclará marcas de uso o fallas.</p>
              <p>04 &nbsp; Contá quién está detrás.</p>
            </div>
          </aside>
        </div>
        <section class="honesty">
          <h2 class="display">HECHO CON HONESTIDAD.</h2>
          <p>
            Publicá solo piezas propias o que puedas vender. Sin copias engañosas, sin
            especificaciones inventadas. Leé los términos antes de publicar.
          </p>
        </section>
      </main>
      @Footer()
    </div>
  </body>
</html>
}
