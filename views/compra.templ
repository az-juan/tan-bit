package views

templ Compra(arts []ArticuloData, entregas []string, total float64, totalXmr float64) {
	@Route("CARRITO / COMPRA", "CHECKOUT")
	<h1 class="display page-title">COMPRA</h1>
	@Formulario("/compra", "post", "compra-layout", "", false, CompraForm(arts, entregas, total, totalXmr))
}

// CompraForm deja el pedido y el resumen a la izquierda, y la ilustración a la derecha.
templ CompraForm(arts []ArticuloData, entregas []string, total float64, totalXmr float64) {
	<div class="compra-info">
		<aside class="order-block">
			@Marco("veg-vl steel veg-3 copper order-summary", ResumenPedido(arts, entregas, total, totalXmr))
			<div class="productos-resumen">
				<h3 class="display">RESUMEN DE PRODUCTOS</h3>
				<div class="productos-list">
					for _, a := range arts {
						@Articulo(a, ArticuloConfig{})
					}
				</div>
			</div>
		</aside>
	</div>
	<div class="compra-arte">
		<img src="/static/assets/finn_jake_bmo.gif" alt="Finn y Jake con una compu" />
		<span>A un paso de obtener tu compra.</span>
	</div>
}

templ ResumenPedido(arts []ArticuloData, entregas []string, total float64, totalXmr float64) {
	<h2 class="display">TU PEDIDO</h2>
	<hr />
	<table class="order-table">
		<thead>
			<tr>
				<th>PRODUCTO</th>
				<th>CANTIDAD</th>
				<th>PRECIO</th>
				<th>XMR</th>
				<th>ALIAS DEL VENDEDOR</th>
				<th>CBU</th>
				<th>DIRECCIÓN XMR</th>
			</tr>
		</thead>
		<tbody>
			for _, a := range arts {
				<tr id="row-{ a.IDArticulo }">
					<td>{ a.Titulo }</td>
					<td>×{ a.Cantidad }</td>
					<td>${ a.Precio }</td>
					if a.PrecioXmr > 0 {
						<td>XMR ${ a.PrecioXmr }</td>
					}
					<td>{ a.Alias }</td>
					<td>{ a.Cbu }</td>
					<td>{ a.DireccionXmr.String }</td>
				</tr>
			}
		</tbody>
	</table>
	<hr />
	<div class="delivery-block">
		<h3 class="display">TIPO DE ENTREGA</h3>
		<div class="delivery-options">
			for _, et := range entregas {
				<label class="delivery-option">
					<input type="radio" name="entrega" value={ et } checked={ et == entregas[0] } />
					<span>{ et }</span>
				</label>
			}
		</div>
	</div>
	<hr />
	<div class="order-total">
		<span>TOTAL</span>
		<strong>${ total }</strong>
	</div>
	<button type="submit" class="btn">Confirmar compra ↗</button>
	<small>Pesos argentinos · Otros medios según el vendedor.</small>
}
