package views

import (
    "tan-bit.com/tan-bit/db/sqlc"
)

templ Marketplace(articulos []db.GetArticulosRow, filtros []FiltroCategoria) {

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TAN-BIT · Marketplace</title>
    <link rel="stylesheet" href="/static/css/shared.css" />
    <link rel="stylesheet" href="/static/css/marketplace.css" />
  </head>
  <body>
    <div class="page marketplace-page">
      @Header()
      <main class="market-main">
        <section class="hero pixel-frame copper">
          <div class="hero-copy">
            <h1 class="display">TU PRÓXIMA JOYA DEL<br />HARDWARE.</h1>
            <nav class="hero-links">
              <a href="./vender">·&gt; VENDER</a>
              <a href="./evento">·&gt; IR A EVENTO</a>
              <a href="#productos">·&gt; ARTÍCULOS RECIENTES</a>
            </nav>
          </div>
          <div class="hero-art">
            <img
             src="/static/assets/finn-y-jake.gif"
             width="300"
             alt="finn, jake y bmo"
            />
          </div>
        </section>
        
        <section id="productos" class="catalog">
          <div class="filters">
          for i, f := range filtros {
            if i == 0 {
              <button class="active">{ f.Label } [{ f.Count }]</button>
            } else {
              <button>{ f.Label } [{ f.Count }]</button>
            }
          }
        </div>
          <div class="product-grid market-products">
            @Articulos(articulos)
          </div>
        </section>
      </main>
      @Footer()
    </div>
  </body>
</html>
 }
