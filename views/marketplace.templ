package views

import (
    "tan-bit.com/tan-bit/db/sqlc"
)

templ Marketplace(articulos []db.GetArticulosRow, filtros []FiltroCategoria) {
  <section class="hero pixel-frame veg-vs codo-2verdigris copper">
    <div class="hero-copy">
      <h1 class="display">TU PRÓXIMA JOYA DEL<br />HARDWARE.</h1>
      <nav class="hero-links">
        <a href="./vender">·&gt; VENDER</a>
        <a href="./evento">·&gt; IR A EVENTO</a>
        <a href="./creadores">·&gt; CREADORES</a>
      </nav>
    </div>
    <div class="hero-art">
      <img
       src="/static/assets/retro_console.gif"
       width="300"
       alt="Gamecube en tv retro"
      />
    </div>
  </section>

  <section id="articulos" class="catalog">
    <div class="filters" role="tablist">
    for i, f := range filtros {
      <a role="tab" href={ "./?categoria=" + string(f.Key) } class={"filter-btn tab "+map[bool]string{true: "active", false: ""}[i == 0]} hx-get={ "./?categoria=" + string(f.Key) } hx-target="closest #productos" hx-swap="outerHTML" hx-push-url="true">
        { f.Label } [{ f.Count }]
      </a>
    }
  </div>
    <div class="product-grid market-products">
      @Articulos(articulos)
    </div>
  </section>
}
