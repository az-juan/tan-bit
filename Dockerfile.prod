# Etapa 1: compilar binario
FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /app/tan-bit

# Etapa 2: imagen final (solo el binario)
FROM alpine:3.20 AS final
RUN adduser -D -u 1000 app
RUN apk add --no-cache curl
WORKDIR /app
USER app
COPY --from=builder /app/tan-bit /usr/local/bin/tan-bit
COPY static static
CMD ["tan-bit"]
